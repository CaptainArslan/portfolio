# Resend — https://resend.com/api-keys
#
# Vercel: Project → Settings → Environment Variables — same names as below.
# Check Production (and Preview if you use preview URLs). Redeploy after saving.
#
RESEND_API_KEY=re_xxxxxxxx

# ─── FROM (sender) — must NOT be @gmail.com / Yahoo / etc. ───
# Resend only sends From addresses on domains YOU verify:
#   https://resend.com/domains
# Examples:
#   Production:  RESEND_FROM="Muhammad Arslan <hello@yourdomain.com>"
#   Quick test:  RESEND_FROM="Portfolio <onboarding@resend.dev>"
# Your Gmail belongs below (CONTACT_NOTIFICATION_EMAIL), not here.

RESEND_FROM="Portfolio <onboarding@resend.dev>"

# ─── TO (your inbox) — Gmail is fine here ───
CONTACT_NOTIFICATION_EMAIL=you@gmail.com
